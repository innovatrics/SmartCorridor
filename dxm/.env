# DSS and CEA: places, versions and switches. Never a secret here; secrets are files in DXM_SECRETS_DIR (README.md).
REGISTRY=registry.dot.innovatrics.com/border-control/
DSS_VERSION=0.4.0
CEA_VERSION=0.3.1

# TIS (0.34.0 or later) with its context path, and TIS's own token issuer (OAuth 2.0 client credentials).
TIS_BASE_URL=
TIS_TOKEN_URL=
DSS_TIS_CLIENT_ID=
CEA_TIS_CLIENT_ID=

# The dxm.deployment label of the members this DSS owns, and CEA's filter: [a-z0-9][a-z0-9-]{0,31}, unique per
# FaceMatcher and distinct from every other deployment on the same TIS.
DSS_DEPLOYMENT_ID=
# The FaceMatcher watchlist route r1 fills (its id, as VPP returns it when the watchlist is created; dxm/README.md,
# "Configuration"). The DSS never creates or deletes it.
DSS_WATCHLIST_ID=
# scopeId=unitId[@location]; the location is the Encounter's location in TIS. The Hub's one unit is corridor-1.
CEA_SCOPES=corridor-1=corridor-1@${DSS_DEPLOYMENT_ID}
# Matches less than this apart are one visit and one Encounter, written within seconds of the first match; a match
# after a longer pause opens a new visit and a new Encounter.
CEA_PASSAGE_QUIET=PT2M

# Document scans (passport pages) in the Operational Display: off. Only where the deployment's owner has accepted
# copies of travel documents on this machine (README.md, "Document scans"). To switch them on, run
# dxm/setup-documents.sh once, then set DOCUMENT_IMAGES=true, uncomment the three lines below and set
# HUB_DOCUMENT_IMAGES_ENABLED=true in .env.hub.
DOCUMENT_IMAGES=false
#DOCUMENT_IMAGES_STORAGE_ENDPOINT=http://sceg-documents:8333
#DOCUMENT_IMAGES_STORAGE_BUCKET=corridor-documents
#COMPOSE_PROFILES=documents
# Days a copy lives in the store; setup-documents.sh publishes the same value as the store's expiry rule (rerun it
# after a change).
DOCUMENT_IMAGES_EXPIRY_DAYS=30

DSS_PORT=8660
CEA_PORT=8670
DXM_SECRETS_DIR=${HOME}/.config/smart-corridor/dxm
