# DSS and CEA: places, versions and switches. Never a secret here; secrets are files in DXM_SECRETS_DIR (README.md).
REGISTRY=registry.dot.innovatrics.com/border-control/
DSS_VERSION=0.3.1
CEA_VERSION=0.3.1

# TIS (0.29.0 to 0.33.x) with its context path, and TIS's own token issuer (OAuth 2.0 client credentials).
TIS_BASE_URL=
TIS_TOKEN_URL=
DSS_TIS_CLIENT_ID=
CEA_TIS_CLIENT_ID=

# TIS signs portrait URLs for its object store's host. Where that host does not resolve from here, start with
# --profile relay: the relay answers under that name and port and forwards the TCP stream to UPSTREAM.
TIS_OBJECT_STORE_HOST=
TIS_OBJECT_STORE_PORT=8333
TIS_OBJECT_STORE_UPSTREAM=

# The dxm.deployment label of the members this DSS owns, and CEA's filter: [a-z0-9][a-z0-9-]{0,31}, unique per
# Face Matcher and distinct from every other deployment on the same TIS.
DSS_DEPLOYMENT_ID=
# scopeId=unitId[@location]; the location is the Encounter's location in TIS. The Hub's one unit is corridor-1.
CEA_SCOPES=corridor-1=corridor-1@${DSS_DEPLOYMENT_ID}
# A visit becomes an Encounter after this long without a further match.
CEA_PASSAGE_QUIET=PT2M

DSS_PORT=8660
CEA_PORT=8670
DXM_SECRETS_DIR=${HOME}/.config/smart-corridor/dxm
