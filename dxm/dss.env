VPP_BASE_URL=http://api:8080
VPP_GRAPHQL_URL=http://graphql-api:8080/graphql
TZ=Europe/Bratislava
DSS_MAX_CANDIDATES_PER_RUN=5000
DSS_MAX_SNAPSHOT_ITEMS=100000
DISPLAY_LABELS=true
HEALTH_LISTEN=0.0.0.0:8660
LOG_LEVEL=info
# Without it the DSS logs a failed trace export to localhost:4317 every few seconds.
TRACING_ENABLED=false
# Portraits come through TIS's API (GET /api/v1/stored-objects/{id}/content, TIS 0.34.0 or later) with the DSS's
# token, not from TIS's object store, which is not reachable from outside TIS's cluster.
TIS_OBJECT_DOWNLOAD=content
# Document images (DOCUMENT_IMAGES) stay off: copies of travel documents go to isolated nodes only.

# Route r1 (SOURCE_MODE=travelers, DSS 2.3.0): every ENROLLED traveler with a portrait in TIS, no journey needed,
# into the one watchlist DSS_WATCHLIST_ID of dxm/.env (ROUTE_1_DESTINATION, set by the compose file). The members
# mirror TIS: a traveler TIS no longer lists as ENROLLED leaves the watchlist. A deletion run that would remove more
# than half of the members (ROUTE_1_MAX_REMOVAL_FRACTION, default 0.5; one member may always leave) removes no one
# and fails with removalGuard, run after run (dxm/README.md, "Typical failures"). More than SIZE_BOUND selected
# travelers stop the run (sizeBound) before it writes anything. Document scans stay off here (DOCUMENT_IMAGES); where
# they are on, DSS 0.4.0 copies the scans of a travelers route's members too.
ROUTE_1_ID=r1
ROUTE_1_SOURCE_MODE=travelers
ROUTE_1_WATCHLIST_MODE=single
ROUTE_1_MAPPING=displayName=traveler.firstName+traveler.lastName,fullName=traveler.firstName+traveler.lastName
ROUTE_1_SIZE_BOUND=1000
# Every sync reads each ENROLLED traveler's biometrics and documents from TIS, about two reads per traveler: above
# about 500 travelers use 5 minutes or more, and at least three times the sync's durationMs (DSS README, "Running a
# travelers route").
ROUTE_1_SYNC_INTERVAL_MINUTES=1
ROUTE_1_DELETE_INTERVAL_MINUTES=15

# Alternative, instead of the route above (one route per traveler: two routes that select the same traveler report
# routeOwnershipConflict): travelers of journeys arriving in the next 24 h, a watchlist per flight
# dxm.r1.flight.<flight>.<yyyyMMddHHmm>, with ROUTE_1_DESTINATION removed from the compose file.
#ROUTE_1_ID=r1
#ROUTE_1_WINDOW=NEXT:24h
#ROUTE_1_MAPPING=displayName=traveler.firstName+traveler.lastName,fullName=traveler.firstName+traveler.lastName,note=journey.conveyanceNumber
#ROUTE_1_SIZE_BOUND=5000
#ROUTE_1_SYNC_INTERVAL_MINUTES=1
#ROUTE_1_DELETE_INTERVAL_MINUTES=15
#ROUTE_1_DELETE_OLDER_THAN_MINUTES=180
