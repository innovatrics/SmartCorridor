{
  "realm": "corridor",
  "enabled": true,
  "displayName": "Smart Corridor",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "passwordPolicy": "length(12) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "corridor-operator",
        "description": "Operational Display (port 8095): watch the corridor"
      },
      {
        "name": "face-matcher-admin",
        "description": "Face Matcher UI (port 8000): cameras, watchlists, members"
      },
      {
        "name": "corridor-admin",
        "description": "The Hub's write surface /corridor-hub/admin/ and the APIs"
      },
      {
        "name": "corridor-integrator",
        "description": "Systems: the Hub API (8090) and Face Matcher's APIs (8098, 8097)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "corridor-gateway",
      "description": "The gateway's login for administrators' browser ports",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_CORRIDOR_GATEWAY_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://${CORRIDOR_HOST}:8000/oauth2/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${CORRIDOR_HOST}:8000/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "acr"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-corridor-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "corridor-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "corridor-display",
      "description": "The gateway's login for the Operational Display: long-living sessions",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_CORRIDOR_DISPLAY_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://${CORRIDOR_HOST}:8095/oauth2/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${CORRIDOR_HOST}:8095/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "acr"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "audience-corridor-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "corridor-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "corridor-gateway",
      "roles": [
        "face-matcher-admin",
        "corridor-admin"
      ]
    },
    {
      "client": "corridor-display",
      "roles": [
        "corridor-operator"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
