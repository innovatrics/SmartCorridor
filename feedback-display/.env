# Feedback Display (SASCE-115), optional. See feedback-display/README.md.
REGISTRY=registry.dot.innovatrics.com/border-control/
FEEDBACK_DISPLAY_VERSION=0.1.0
# Where setup.sh keeps the service's database login, outside the repository.
FEEDBACK_DISPLAY_SECRETS_DIR=${HOME}/.config/smart-corridor/feedback-display
# The address the display pages and the configuration API listen on. 127.0.0.1 = this machine only: the configuration
# API has no login yet. Set 0.0.0.0 only on a network you trust, to open the displays from other machines.
FEEDBACK_DISPLAY_BIND=127.0.0.1
FEEDBACK_DISPLAY_PORT=8087
