# Corridor Signal Controller: turns the Hub's clearance decisions into colours on the pole's LED stripe
# (Shelly Pro RGBWW, Gen2 RPC). Without a device the controller runs and does nothing; the block below is set
# for the reference pole, so it works out of the box there.
# All settings: https://gitlab.ba.innovatrics.net/border-control/corridor-signal-controller (README, application.yml).
#
# Shipped defaults: GREEN, BLUE (unidentified) and RED solid; Hub lost (UNAVAILABLE) blinks orange after 10 s;
# idle is white on the stripe's white channel (needs the Shelly in the rgbcct profile), set below: warm white, full brightness.

# ── One block per Shelly; numbered from 0 ──────────────────────────────────────────────────────────────
SIGNAL_CONTROLLER_DEVICES_0_ID=pole-1
# The Shelly of the reference pole; change it to the address of this site's Shelly.
SIGNAL_CONTROLLER_DEVICES_0_ADDRESS=http://10.20.57.16
SIGNAL_CONTROLLER_DEVICES_0_CHANNEL=0
# Shelly password, when its authentication is on (user admin).
#SIGNAL_CONTROLLER_DEVICES_0_PASSWORD=
# VPP camera ids this pole reacts to; empty or unset ⇒ every camera of the corridor.
#SIGNAL_CONTROLLER_DEVICES_0_CAMERAIDS=
# Which outcomes the pole shows: any of GREEN, BLUE, RED, OCCLUDED. E.g. GREEN,RED never shows BLUE.
#SIGNAL_CONTROLLER_DEVICES_0_SETTINGS_REACTSTO=GREEN,BLUE,RED
# No idle light on this pole.
#SIGNAL_CONTROLLER_DEVICES_0_SETTINGS_SIGNALS_OFF_ENABLED=false
# Idle light on the RGB light instead, for a Shelly in the RGB-only profile.
#SIGNAL_CONTROLLER_DEVICES_0_SETTINGS_SIGNALS_OFF_COLOR="#FFFFFF"

# ── Corridor-wide defaults (every device unless it overrides them) ──────────────────────────────────────
#SIGNAL_CONTROLLER_DEFAULTS_SIGNALS_GREEN_COLOR="#00FF00"
# Idle light: on, warm white, brightness 0..100. 2700 K: the reference pole's stripe has its white LEDs on the
# Shelly's warm-white output only, so a cooler value (up to 6500 K, cool-white output only) stays dark there.
SIGNAL_CONTROLLER_DEFAULTS_SIGNALS_OFF_ENABLED=true
SIGNAL_CONTROLLER_DEFAULTS_SIGNALS_OFF_COLORTEMPERATURE=2700
SIGNAL_CONTROLLER_DEFAULTS_SIGNALS_OFF_BRIGHTNESS=100

# Disco: true turns a pole (or, as a default, every pole) into a light show that ignores the Hub. Demo only.
#SIGNAL_CONTROLLER_DEVICES_0_SETTINGS_DISCO=true
