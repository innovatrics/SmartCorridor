# FaceMatcher UI settings. IDENTIFICATION_ENABLED is set in docker-compose.override.yml.

# Login and HTTPS: both OFF. FOR EVALUATION, DEMOS AND EXPERIMENTS ON A TRUSTED NETWORK ONLY: whoever reaches
# port 8000 has full access to the members' photos, the results and the live video, and can change cameras and
# watchlists. FaceMatcher UI has the Keycloak login on by default and does not start without its Keycloak
# settings; the line KEYCLOAK_AUTHENTICATION_ENABLED=false is what lets it run without login. Production turns
# the Keycloak login on, over HTTPS: see README, "Turning the login on" (a standalone FaceMatcher; in a Smart
# Corridor see the corridor's README).
KEYCLOAK_AUTHENTICATION_ENABLED=false
# Keycloak's base URL as both the browser and this server reach it: https://, without /auth (Keycloak 17 and newer)
# KEYCLOAK_DOMAIN=https://sso.example.com
# KEYCLOAK_REALM=face-matcher
# KEYCLOAK_CLIENT_ID=face-matcher-ui
# The client secret has no line here: it belongs in secrets/face-matcher-ui.env, which is git-ignored.
# The one role that grants access: a realm role, or a client role of KEYCLOAK_CLIENT_ID
# KEYCLOAK_ROLE=face-matcher-admin
# With the login on, true leaves the live camera video readable without login
# VIDEO_WITHOUT_LOGIN=false
# HTTPS served by FaceMatcher UI itself; with the login on, the UI works only over HTTPS. The key and the
# certificate are mounted from secrets/tls/ (docker-compose.override.yml).
HTTPS_ENABLED=false
# HTTPS_HOST_NAME=face-matcher.example.com
# HTTPS_KEY_FILE=/certs/server.key
# HTTPS_CERT_FILE=/certs/server.crt

# IP address, where FaceMatcher UI server will bind to
HOST=0.0.0.0

# Port number, where FaceMatcher UI server will bind to
PORT=8000

# Full address of FaceMatcher's REST API
# example: http://[api-host]:[port]/api/v1
CORE_API_ROOT=http://api:8080/api/v1

# Full address of FaceMatcher's GraphQL API
GRAPHQL_ROOT=http://graphql-api:8080/graphql

# example: CAM_PREVIEW_HOST_[camera.serviceName]=[camera-host]
CAM_PREVIEW_HOST_SFCAM1=cam-1
CAM_PREVIEW_HOST_SFCAM2=cam-2
CAM_PREVIEW_HOST_SFCAM3=cam-3
CAM_PREVIEW_HOST_SFCAM4=cam-4
CAM_PREVIEW_HOST_SFCAM5=cam-5

# Comma separated Watchlist IDs used as a global blacklist. Replace the placeholder below.
BLACKLIST_WATCHLIST_IDS=abcdabcd-abcd-1234-abcd-abcdabcdacd

# Score to percentage conversion parameters
SCORE_CONVERSION_LOWER_LIMIT=20
SCORE_CONVERSION_LOWER_LIMIT_PERCENTAGE=30
SCORE_CONVERSION_UPPER_LIMIT=40
SCORE_CONVERSION_UPPER_LIMIT_PERCENTAGE=90

# DOT camera parameters (HTTPS is required)
DOT_FACE_CAMERA_ENABLED=false
DOT_FACE_CAMERA_FACE_CENTER_LIMIT=0.2
DOT_FACE_CAMERA_FACE_CONFIDENCE=0.06

# Add optional labels to watchlist member (key is used in API requests, label is visual representation of key and used only in the UI)
# Default set = the SmartCorridor watchlist member label set (keys and value formats in the SmartCorridor integration docs).
# Identity
WATCHLIST_MEMBER_KEY_0=firstName
WATCHLIST_MEMBER_LABEL_0=First Name
WATCHLIST_MEMBER_KEY_1=lastName
WATCHLIST_MEMBER_LABEL_1=Last Name
WATCHLIST_MEMBER_KEY_2=dob
WATCHLIST_MEMBER_LABEL_2=Date of Birth
WATCHLIST_MEMBER_KEY_3=sex
WATCHLIST_MEMBER_LABEL_3=Sex
WATCHLIST_MEMBER_KEY_4=country
WATCHLIST_MEMBER_LABEL_4=Nationality
WATCHLIST_MEMBER_KEY_5=placeOfBirth
WATCHLIST_MEMBER_LABEL_5=Place of Birth
# Travel document
WATCHLIST_MEMBER_KEY_6=doc
WATCHLIST_MEMBER_LABEL_6=Document
WATCHLIST_MEMBER_KEY_7=docType
WATCHLIST_MEMBER_LABEL_7=Document Type
WATCHLIST_MEMBER_KEY_8=docCountry
WATCHLIST_MEMBER_LABEL_8=Issuing Country
WATCHLIST_MEMBER_KEY_9=docIssued
WATCHLIST_MEMBER_LABEL_9=Issued
WATCHLIST_MEMBER_KEY_10=docExpiry
WATCHLIST_MEMBER_LABEL_10=Expires
# Journey
WATCHLIST_MEMBER_KEY_11=flight
WATCHLIST_MEMBER_LABEL_11=Flight
WATCHLIST_MEMBER_KEY_12=route
WATCHLIST_MEMBER_LABEL_12=Route
WATCHLIST_MEMBER_KEY_13=arrival
WATCHLIST_MEMBER_LABEL_13=Arrival
WATCHLIST_MEMBER_KEY_14=seat
WATCHLIST_MEMBER_LABEL_14=Seat
# Document images (stable URLs)
WATCHLIST_MEMBER_KEY_15=docFrontUrl
WATCHLIST_MEMBER_LABEL_15=Document Front (URL)
WATCHLIST_MEMBER_KEY_16=docBackUrl
WATCHLIST_MEMBER_LABEL_16=Document Back (URL)

# IDENTIFICATION_ENABLED is set in docker-compose.override.yml (FACE_MATCHER_UI_IDENTIFICATION in .env).

# Configure logging
ENABLE_LOGGING=true
LOG_TO_FILE=false
LOG_FORMAT_JSON=false
LOG_FILE_DATE_PATTERN="YYYY-MM-DD"
LOG_FILE_MAX_SIZE="20m"
LOG_FILE_MAX_FILES="1d"
LOG_LEVEL="info"

# Number of parallel register api calls for advanced registration page
BULK_MEMBER_REGISTER_PARALLELISM=4

# Face validation mode (predefined, none)
FACE_VALIDATION_MODE=predefined

# The palm services run, but FaceMatcher UI keeps its palm screens off.
PALMS_ENABLED=false

# License file path
LICENSE_FILE_PATH="/etc/innovatrics/iengine.lic"
