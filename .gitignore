# Licensed material — never commit. start.sh links secrets/iengine.lic into the vendored
# Face Matcher, whose own .gitignore covers those links as well.
secrets/*.lic
face-matcher/secrets/*.lic
face-matcher/iengine.lic
# The gateway's secrets and certificate, written by start.sh (or the site's own certificate)
secrets/gateway/
secrets/tls/

# Local-only tooling (internal registry migration scripts etc.) — never commit
.local/

# macOS
.DS_Store
__MACOSX/

# DSS/CEA secrets belong in DXM_SECRETS_DIR, outside the repository (dxm/README.md)
dxm/tis-*.env
dxm/cea-local.env
