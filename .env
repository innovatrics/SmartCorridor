REGISTRY=registry.dot.innovatrics.com/border-control/

# Start order is CIGS, Hub, Display. The Hub identifies through CIGS: without CIGS it identifies no one, silently.
# Display 0.13.0 needs Hub 0.13.0. Fallback: HUB_VERSION=0.12.0 and FRONTEND_VERSION=0.12.0.
CIGS_VERSION=0.5.0
HUB_VERSION=0.13.0
FRONTEND_VERSION=0.13.0
FRONTEND_PORT=8095

# Face Matcher versions are in face-matcher/.env.

# The gateway: Envoy in front of the whole corridor, every port HTTPS, a Keycloak login for people and tokens for
# systems (README.md, "The gateway"). true or false; anything else stops start.sh. Which of the two is the default
# is not decided yet.
CORRIDOR_GATEWAY_ENABLED=false
# With the gateway on: the one name (or IPv4 address) under which operators and systems reach this host. Its
# certificate is issued for it. Empty: the host's name.
CORRIDOR_HOST=
GATEWAY_IMAGE=envoyproxy/envoy:v1.40.2
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
